# Copiar este archivo como .env y completar los valores
SECRET_KEY=colocar-una-clave-secreta
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Contraseña de los usuarios de prueba (python manage.py cargar_demo_auth)
DEMO_PASSWORD=clave-demo-123

